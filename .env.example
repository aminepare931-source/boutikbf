# Supabase credentials (get these from your Supabase Project Settings)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Paiement en ligne des abonnements (GeniusPay) : voir docs/GENIUSPAY.md ---
# Sans ces 3 clés, le paiement en ligne reste désactivé et l'application garde le paiement manuel.
GENIUSPAY_API_KEY=
GENIUSPAY_API_SECRET=
GENIUSPAY_WEBHOOK_SECRET=
# Adresse publique du site, sans « / » final (utilisée pour le retour après paiement)
SITE_URL=https://votre-site.vercel.app
# À mettre à 1 UNIQUEMENT sur un déploiement de test avec des clés pk_sandbox_ / sk_sandbox_
# GENIUSPAY_ALLOW_SANDBOX=1
